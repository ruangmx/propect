# Configuração Global de Desenvolvimento
# Copie para .env antes de rodar o projeto

# Banco de Dados PostgreSQL (Local Docker ou Nuvem Neon/Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prospect_dev"

# Porta da API NestJS
API_PORT=3333

# Segredo JWT para desenvolvimento (substitua em produção)
JWT_SECRET="dev-insecure-jwt-secret-replace-in-production-min-32-chars"

# Chave da Google Places API (New) restrita no Google Cloud
GOOGLE_PLACES_KEY=""

# Chave da API da Anthropic (Claude) para geração de textos das demos (Fase 2)
ANTHROPIC_API_KEY=""

# URL base pública onde as demos ficam acessíveis (ex.: https://demos.4rtech.com.br)
DEMO_BASE_URL="http://localhost:3000"

# URL pública da API para o frontend
NEXT_PUBLIC_API_URL="http://localhost:3333"

